# Copiá a .env y completá. .env nunca se sube al repo.
DOMAIN=ejemplo.com
ACME_EMAIL=tu@email.com
# Usuario y contraseña del dashboard de Traefik. Generalo con:
#   htpasswd -nbB admin 'tu-contraseña'
# y pegalo entre comillas simples (así bash no interpreta los $ del hash):
TRAEFIK_BASIC_AUTH='admin:$2y$05$reemplazame'
STACK_NAME=core
